--label:連番まとめ
--information:連番まとめ（値） v0.2.0
--require:2011700
--group:値1,true
--track@value1:値1::値,-1,999,0,1
--string@export_name1:値1::公開名,
--group:値2,false
--track@value2:値2::値,-1,999,0,1
--string@export_name2:値2::公開名,
--group:値3,false
--track@value3:値3::値,-1,999,0,1
--string@export_name3:値3::公開名,
--group:値4,false
--track@value4:値4::値,-1,999,0,1
--string@export_name4:値4::公開名,
--group
--select@guide_mode:案内の表示=1,編集中だけ=1,常に=2,表示しない=3

-- 連番まとめ（値）
--
-- 連番画像をまとめて切り替える「土台」。HP・MP のような状態表示に向けて、独立した値を4つ持つ。
-- 表示する連番画像は、このオブジェクトに付けたフィルタ効果「連番スロット」で指定する。
--
-- 役割の分担:
--   土台（このスクリプト）: 値を持ち、公開し、連番スロットの画像をまとめて描く。
--   連番スロット: 1つの連番画像と、従う値・オフセット・上限を持つだけ（何もしない）。
--
-- 表示番号 = 従う値 + オフセット（0 が先頭画像）
-- 表示する画像 = 先頭画像のファイル名の、拡張子の直前の数字に、表示番号を足した番号の画像
-- 表示番号が負、上限を超える、または画像が無いときは、そのスロットは何も表示しない（意図的な非表示）。
--
-- 個別オブジェクトの番号（obj.index）:
--   このオブジェクトに付いた連番スロットの、上から何番目か（1番目が 0）。
--   案内を表示するときは、案内が最後の番号になる。

local VALUE_COUNT = 4
-- 自分より下のフィルタ効果を何個まで調べるか。範囲外も「スクリプト以外」も空のテキストになり区別できないため、上限を決める。
local MAX_EFFECTS_BELOW = 64
-- 連番スロットだけが持つ項目。フィルタ効果が連番スロットかどうかの判定に使う。
-- （利用者がファイル名を変えても動くよう、効果名では判定しない）
local SLOT_MARKER_ITEM = "従う値"

local GUIDE_MODE_EDITING_ONLY = 1
local GUIDE_MODE_ALWAYS = 2
local GUIDE_MODE_NEVER = 3

local GUIDE_FONT = "Yu Gothic UI"
local GUIDE_FONT_SIZE = 28
local GUIDE_TEXT_COLOR = 0xffffff
local GUIDE_EDGE_COLOR = 0x000000
local GUIDE_DECORATION_EDGE = 3

local function to_integer(value)
	local number = tonumber(value)
	if number == nil then
		return 0
	end
	return math.floor(number)
end

-- チェックボックスの値は、読み方によって 0/1、"0"/"1"、true/false のどれかで返る。
local function is_checked(value)
	return value == true or value == 1 or value == "1"
end

-- 先頭画像のパスを、番号の前・番号・拡張子に分ける。連番の規則に合わないときは nil を返す。
-- 例: "C:\a\bar_000.png" → "C:\a\bar_", "000", ".png"
local function split_first_image_path(first_image_path)
	local prefix, digits, extension = string.match(first_image_path, "^(.-)(%d+)(%.[^%.\\/]+)$")
	if digits == nil then
		return nil
	end
	return prefix, digits, extension
end

-- 先頭画像のパスと表示番号から、表示する画像のパスを作る。
-- 例: "C:\a\bar_000.png" と 7 → "C:\a\bar_007.png"
local function build_image_path(first_image_path, display_number)
	local prefix, digits, extension = split_first_image_path(first_image_path)
	local image_number = tonumber(digits) + display_number
	local number_text = string.format("%0" .. string.len(digits) .. "d", image_number)
	return prefix .. number_text .. extension
end

-- パスからファイル名だけを取り出す（案内の表示用）。
local function file_name_of(path)
	local name = string.match(path, "([^\\/]+)$")
	if name == nil then
		return path
	end
	return name
end

-- 「値1」〜「値4」の名前から、値の番号を返す。読めないときは nil。
local function value_number_of(source_name)
	local number = tonumber(string.match(tostring(source_name), "(%d+)$"))
	if number == nil or number < 1 or number > VALUE_COUNT then
		return nil
	end
	return number
end

-- このオブジェクトに付いている連番スロットを、上から順に集める。
-- 戻り値: { effect_key = "効果名:n", ... } の配列
local function find_slot_effects()
	local slot_effects = {}
	-- 同じ効果名の、何番目のインスタンスか（obj.getvalue の ":n" に使う）。
	local instance_count_by_name = {}
	for position = 1, MAX_EFFECTS_BELOW do
		-- 無効にしたフィルタ効果は飛ばす（obj.getvalue も無効な効果を数えないため、番号がそろう）。
		local effect_name = obj.getoption("script_name", position, true)
		if effect_name ~= nil and effect_name ~= "" then
			local instance_number = instance_count_by_name[effect_name] or 0
			instance_count_by_name[effect_name] = instance_number + 1
			local effect_key = effect_name .. ":" .. instance_number
			local marker = obj.getvalue(effect_key, SLOT_MARKER_ITEM)
			if marker ~= nil then
				slot_effects[#slot_effects + 1] = { effect_key = effect_key }
			end
		end
	end
	return slot_effects
end

-- 連番スロット1つの設定を読み、表示する画像のパスを決める。
-- 戻り値: 画像のパス（表示しないときは nil）、案内の文（不備が無いときは nil）
local function resolve_slot(effect_key, values)
	local first_image_path = obj.getvalue(effect_key, "画像")
	if type(first_image_path) ~= "string" or first_image_path == "" then
		return nil, nil
	end
	if split_first_image_path(first_image_path) == nil then
		return nil,
			"連番として扱えないファイル名です：" .. file_name_of(first_image_path) .. "\n（拡張子の直前に番号が必要です）"
	end

	local source_name = obj.getvalue(effect_key, "従う値")
	local value_number = value_number_of(source_name)
	if value_number == nil then
		return nil, "この土台には「" .. tostring(source_name) .. "」がありません。"
	end

	local offset = to_integer(obj.getvalue(effect_key, "オフセット"))
	local display_number = values[value_number] + offset
	if display_number < 0 then
		return nil, nil
	end
	if is_checked(obj.getvalue(effect_key, "上限を使う")) then
		local limit = to_integer(obj.getvalue(effect_key, "上限"))
		if display_number > limit then
			return nil, nil
		end
	end
	return build_image_path(first_image_path, display_number), nil
end

local function should_show_guide()
	local mode = to_integer(guide_mode)
	if mode == GUIDE_MODE_ALWAYS then
		return true
	end
	if mode == GUIDE_MODE_NEVER then
		return false
	end
	-- 編集中だけ。動画の出力中は obj.getoption("gui") が false になる。
	return obj.getoption("gui") == true
end

local function load_guide_text(guide_lines)
	obj.setfont(GUIDE_FONT, GUIDE_FONT_SIZE, GUIDE_DECORATION_EDGE, GUIDE_TEXT_COLOR, GUIDE_EDGE_COLOR)
	-- カスタムオブジェクトの中では、自分のスクリプト名を取れない（空になる）ため、固定の見出しにする。
	obj.load("text", "[連番まとめ]\n" .. table.concat(guide_lines, "\n"))
end

-- 値を集め、公開名があれば公開する（テキストなどから global.名前 で参照できる）。
local values = {
	to_integer(value1),
	to_integer(value2),
	to_integer(value3),
	to_integer(value4),
}
local export_names = { export_name1, export_name2, export_name3, export_name4 }
for value_number = 1, VALUE_COUNT do
	local export_name = export_names[value_number]
	if type(export_name) == "string" and export_name ~= "" then
		global[export_name] = values[value_number]
	end
end

-- 連番スロットごとに、表示する画像と、案内の文を決める。
local slot_effects = find_slot_effects()
local image_paths = {}
local guide_lines = {}
local has_any_first_image = false
for slot_index = 1, #slot_effects do
	local effect_key = slot_effects[slot_index].effect_key
	local first_image_path = obj.getvalue(effect_key, "画像")
	if type(first_image_path) == "string" and first_image_path ~= "" then
		has_any_first_image = true
	end
	local image_path, guide_line = resolve_slot(effect_key, values)
	image_paths[slot_index] = image_path
	if guide_line ~= nil then
		guide_lines[#guide_lines + 1] = guide_line
	end
end
if #slot_effects == 0 then
	guide_lines[#guide_lines + 1] = "フィルタ効果「連番スロット」を追加してください。"
elseif not has_any_first_image then
	guide_lines[#guide_lines + 1] = "「連番スロット」に、連番の先頭画像を設定してください。"
end

local show_guide = #guide_lines > 0 and should_show_guide()
local slot_count = #slot_effects
local object_count = slot_count
if show_guide then
	-- 案内は、連番スロットの番号をずらさないよう、最後の個別オブジェクトにする。
	object_count = slot_count + 1
end
if object_count == 0 then
	-- 描くものが無い。何も表示しない。
	return
end

obj.multiobject(object_count, function()
	local slot_index = obj.index + 1
	if slot_index > slot_count then
		load_guide_text(guide_lines)
		return
	end
	local image_path = image_paths[slot_index]
	local loaded = false
	if image_path ~= nil then
		loaded = obj.load("image", image_path)
	end
	if not loaded then
		obj.alpha = 0
	end
end)
